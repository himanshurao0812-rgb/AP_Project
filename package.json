{
  "name": "langchain-rag",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Study RAG built with LangChain.js — chat with PDFs and YouTube videos",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.5.0",
    "@langchain/ollama": "^1.3.1",
    "@langchain/openai": "^1.8.5",
    "@langchain/textsplitters": "^1.0.2",
    "@napi-rs/canvas": "^1.2.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^2.2.2",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
