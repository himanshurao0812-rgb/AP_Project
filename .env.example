# Server
PORT=5178

# ---------- Language model (optional) ----------
# auto      = use an OpenAI-compatible API if a key exists, else a local Ollama
#             if it is running, else fall back to extractive answers
# openai | ollama | extractive
LLM_PROVIDER=auto

# Preferred names (works with DeepSeek, OpenRouter, Groq, vLLM, …):
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-v4.1-flash:free

# OpenAI-style aliases (also read, in case you already use them):
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ---------- Embeddings ----------
# local = @huggingface/transformers all-MiniLM-L6-v2 (no API key, downloads once)
# openai = text-embedding-3-small (requires OPENAI_API_KEY or LLM_API_KEY)
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Retrieval ----------
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.12
